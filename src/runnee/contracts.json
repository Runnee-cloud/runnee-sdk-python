      "required": [
        "days",
        "total",
        "success",
        "failed",
        "successRate",
        "daily",
        "topScripts",
        "topScriptsSample",
        "apiKeys"
      ],
      "additionalProperties": false
    },
    "TelemetryExecution": {
      "type": "object",
      "properties": {
        "scriptName": {
          "type": "string",
          "maxLength": 200
        },
        "mode": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "maxLength": 40
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "instructionsUsed": {
          "type": "integer",
          "minimum": 0
        },
        "memoryUsageKb": {
          "type": "integer",
          "minimum": 0
        },
        "errorCode": {
          "type": "string",
          "maxLength": 100
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "JSON execution input, at most 8 KiB encoded. Available as ctx.input."
        }
      },
      "required": [
        "status",
        "durationMs",
        "instructionsUsed"
      ],
      "additionalProperties": false
    },
    "TelemetryEvent": {
      "type": "object",
      "properties": {
        "eventName": {
          "type": "string",
          "maxLength": 80
        },
        "pagePath": {
          "type": "string",
          "maxLength": 300
        },
        "sessionId": {
          "type": "string",
          "maxLength": 100
        },
        "fingerprintHash": {
          "type": "string",
          "maxLength": 128
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": [
        "eventName"
      ],
      "additionalProperties": false
    },
    "TelemetryRecorded": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "description": "JSON execution input, at most 8 KiB encoded. Available as ctx.input."
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "Accepted": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted"
      ],
      "additionalProperties": false
    },
    "Health": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "operational",
            "degraded"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "operational",
                  "degraded"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "timestamp",
        "services"
      ],
      "additionalProperties": false
    }
  },
